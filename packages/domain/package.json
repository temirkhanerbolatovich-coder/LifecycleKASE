{
  "name": "@lifecycle-kase/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./financial": {
      "types": "./dist/financial.d.ts",
      "default": "./dist/financial.js"
    },
    "./early-redemption-allocation": {
      "types": "./dist/early-redemption-allocation.d.ts",
      "default": "./dist/early-redemption-allocation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
