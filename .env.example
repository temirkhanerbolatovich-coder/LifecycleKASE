DATABASE_NAME=lifecycle_kase
DATABASE_USER=lifecycle_kase
DATABASE_PASSWORD=local_development_only
DATABASE_PORT=55432
DATABASE_URL=postgresql://lifecycle_kase:local_development_only@[::1]:55432/lifecycle_kase?schema=public
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_COMMITMENT=finalized
SOLANA_CLUSTER=localnet
ONCHAIN_ENTITLEMENT_REGISTRATION_ENABLED=false
SOLANA_GENESIS_HASH=replace_with_local_validator_genesis_hash
PROGRAM_ID=replace_with_cluster_program_id
SOLANA_RPC_TIMEOUT_MS=15000
WALLET_NETWORK=SOLANA_LOCALNET
SNAPSHOT_GRACE_SECONDS=300
# Local coupon funding policy buffer; future execution still needs its own fee/rent checks.
COUPON_NETWORK_RESERVE_LAMPORTS=50000000
PORT=4000
API_LISTEN_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
AUTH_ENABLED=true
AUTH_DOMAIN=localhost
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_CHALLENGE_RATE_LIMIT=5
AUTH_VERIFY_RATE_LIMIT=10
MUTATION_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_CLIENTS=10000
TRUST_PROXY_HOPS=0

# Separate outbound Telegram watchdog. Local secrets may instead go in .local-telegram-monitor.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
MONITOR_NAME=LifecycleKASE
MONITOR_ENVIRONMENT="Render staging + owner Localnet"
MONITOR_TIMEZONE=Asia/Qyzylorda
MONITOR_API_URL=https://lifecyclekase-api.onrender.com
MONITOR_WEB_URL=https://lifecyclekase-web.onrender.com
MONITOR_LOCALNET_ENABLED=true
MONITOR_LOCALNET_RPC_URL=http://127.0.0.1:8899
MONITOR_EXPECTED_GENESIS_HASH=
MONITOR_PROGRAM_ID=
# Optional loopback PostgreSQL connection, preferably a dedicated SELECT-only role.
MONITOR_DATABASE_URL=
MONITOR_POLL_SECONDS=60
MONITOR_SUMMARY_SECONDS=3600
MONITOR_TIMEOUT_SECONDS=30
MONITOR_FAILURE_THRESHOLD=2
MONITOR_STALLED_SLOT_SECONDS=180
MONITOR_PENDING_TRANSACTION_SECONDS=600
MONITOR_STATE_FILE=.local-telegram-monitor-state.json
